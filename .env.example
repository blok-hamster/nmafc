# =============================================================================
# NMAFC Provider Credentials
# Copy this file to .env and fill in the keys for providers you want to use.
# =============================================================================

# =============================================================================
# LLM Providers
# =============================================================================

# --- AWS Bedrock (LLM) ---
# Models: us.anthropic.claude-haiku-4-5-20251001-v1:0, us.anthropic.claude-sonnet-4-20250514-v1:0
AWS_REGION=us-east-1
ANTHROPIC_API_KEY_BEDROCK=

# --- Azure OpenAI (LLM) ---
# Models: DeepSeek-V4-Pro, gpt-4o (depends on your deployment)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI (LLM) ---
# Models: gpt-4o, gpt-4o-mini
OPENAI_API_KEY=

# --- Anthropic (direct, non-Bedrock) ---
# Models: claude-sonnet-4-20250514, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# --- Groq (LLM) ---
# Models: llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_API_KEY=

# --- OpenRouter (LLM) ---
# Models: anthropic/claude-sonnet-4-20250514, meta-llama/llama-3.1-405b
OPENROUTER_API_KEY=

# --- Together AI (LLM) ---
# Models: meta-llama/Llama-3-70b-chat-hf
TOGETHER_API_KEY=

# --- Ollama (local LLM) ---
# Models: llama3.2, mistral, phi3
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- LM Studio (local LLM) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- vLLM (local LLM) ---
VLLM_BASE_URL=http://localhost:8000/v1

# =============================================================================
# Embedding Providers
# =============================================================================

# --- OpenAI Embeddings ---
# Models: text-embedding-3-small (1536-dim), text-embedding-3-large (3072-dim)
# Uses OPENAI_API_KEY above
# Usage: --embedding "openai/text-embedding-3-small"

# --- Azure OpenAI Embeddings ---
# Models: text-embedding-3-small, text-embedding-ada-002 (deploy on your Azure resource)
# Uses AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY above
# Usage: --embedding "azure/text-embedding-3-small"

# --- AWS Bedrock Embeddings ---
# Models: amazon.titan-embed-text-v2:0, cohere.embed-english-v3
# Requires IAM credentials (AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY), NOT the ABSK key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Usage: --embedding "bedrock/amazon.titan-embed-text-v2:0"

# --- Ollama Embeddings (local) ---
# Models: nomic-embed-text (768-dim), mxbai-embed-large (1024-dim), all-minilm (384-dim)
# Uses OLLAMA_BASE_URL above
# Usage: --embedding "ollama/nomic-embed-text"

# --- Together AI Embeddings ---
# Models: togethercomputer/m2-bert-80M-8k-retrieval
# Uses TOGETHER_API_KEY above
# Usage: --embedding "together/togethercomputer/m2-bert-80M-8k-retrieval"

# --- Voyage AI Embeddings (via OpenAI-compatible) ---
# Models: voyage-3, voyage-3-lite
VOYAGE_API_KEY=
# Usage: requires custom base_url setup

# =============================================================================
# Framework Defaults (used by NeuromorphicMemory.from_config())
# =============================================================================
NMAFC_LLM_PROVIDER_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
NMAFC_EMBEDDING_PROVIDER_MODEL=ollama/nomic-embed-text

# Vector width of the hot-storage column. SET THIS whenever your embedding model
# is not 1536-dim -- nomic-embed-text is 768, mxbai-embed-large is 1024,
# all-minilm is 384. Leaving it unset makes NeuromorphicMemory probe the provider
# at startup, which runs the async embedder on a second event loop; if that
# provider was already used on the calling loop, the probe blocks until timeout.
NMAFC_EMBEDDING_DIM=768

# Seconds to wait on that startup probe before falling back to the configured dim.
NMAFC_EMBED_PROBE_TIMEOUT=30

# Sampling temperature sent with every completion. Leave blank for the provider
# default; set to 0 for reproducible benchmark runs.
NMAFC_LLM_TEMPERATURE=

# =============================================================================
# Multi-Tenancy / Isolation
# =============================================================================
# Scopes all storage (Hot RAM + Cold ROM) to this agent/tenant.
# Different agents writing to the same storage backend will NOT see each other's memories.
NMAFC_AGENT_ID=default

# Scopes memories to a specific conversation thread.
# Same agent can run multiple conversations without leaking context between them.
NMAFC_CONVERSATION_ID=default

# =============================================================================
# Remote Storage (optional — defaults to local files)
# =============================================================================
# Hot RAM: local path or S3 URI for remote vector store
NMAFC_HOT_URI=./data/lancedb
# Cold ROM: local .db path or PostgreSQL/CockroachDB DSN for remote event log
NMAFC_COLD_URI=./data/cold.db

# --- Self-hosted S3 (MinIO, Ceph, Wasabi, R2) ---
# Uncomment to redirect S3 calls to your self-hosted bucket
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_ALLOW_HTTP=true

# =============================================================================
# Benchmark Defaults (used by run_locomo.py / run_longmemeval.py)
# =============================================================================
NMAFC_BENCH_PROVIDER=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
NMAFC_BENCH_EMBEDDING=ollama/nomic-embed-text

# --- Parallelism ---
# Conversations evaluated concurrently, and judge calls in flight.
NMAFC_BENCH_CONCURRENCY=8
NMAFC_BENCH_JUDGE_CONCURRENCY=12

# --- Rate limiting / retries ---
# Match these to your deployment's real quota. Read the x-ratelimit-* response
# headers to confirm -- published quota tables are frequently wrong.
NMAFC_BENCH_TPM_LIMIT=500000
NMAFC_BENCH_RPM_LIMIT=500
# Fraction of the quota to actually use, leaving headroom for burst.
NMAFC_BENCH_QUOTA_SAFETY=0.85
NMAFC_BENCH_MAX_RETRIES=6

# --- RAG arm tuning ---
# Turns per chunk, stride between chunk starts, and passages retrieved per query.
NMAFC_RAG_CHUNK_TURNS=4
NMAFC_RAG_CHUNK_STRIDE=2
NMAFC_RAG_TOP_K=10
